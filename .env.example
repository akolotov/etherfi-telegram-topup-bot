# Keep this stable for one deployment; production and test need different names.
COMPOSE_PROJECT_NAME=your-bot-deployment

# Published images are pulled by default. For local builds, use
# ETHERFI_TOPUP_BOT_IMAGE=etherfi-topup-bot:local and
# ETHERFI_TOPUP_BOT_PULL_POLICY=never.
# ETHERFI_TOPUP_BOT_IMAGE=ghcr.io/akolotov/etherfi-telegram-topup-bot:latest
# ETHERFI_TOPUP_BOT_PULL_POLICY=always

BOT_TOKEN=123456:telegram-bot-token
INGRESS_MODE=polling
TELEGRAM_API_BASE_URL=https://api.telegram.org
CONFIG_PATH=data/config.json
STATE_DIR=data/user_states
# Tailscale Funnel gateway route. Replace each placeholder and keep the Docker
# alias identical to the corresponding segment in WEBHOOK_PATH.
WEBHOOK_PUBLIC_BASE_URL=https://<funnel-hostname>.<tailnet>.ts.net
WEBHOOK_DOCKER_ALIAS=<docker-alias>
WEBHOOK_PATH=/hooks/<docker-alias>/<webhook-endpoint>
MINI_APP_PUBLIC_URL=https://<funnel-hostname>.<tailnet>.ts.net/apps/<docker-alias>/topup
WEBHOOK_SECRET_TOKEN=replace-with-random-secret
WEBHOOK_LISTEN_HOST=0.0.0.0
WEBHOOK_LISTEN_PORT=8080

LOG_LEVEL=INFO

BLOCKSCOUT_PRO_API_KEY=proapi_...
BLOCKSCOUT_MAX_ATTEMPTS=3
BLOCKSCOUT_RETRY_INITIAL_DELAY_SECONDS=0.5
BLOCKSCOUT_RETRY_BACKOFF_FACTOR=2
SAFE_TRANSACTION_SERVICE_API_KEY=...
